# Copy this file to ".env" and paste your real key below.
# The ".env" file is listed in .gitignore so your key is NEVER uploaded to GitHub.

# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model your tracker uses to summarize pros, cons, and pricing
GEMINI_MODEL=gemini-3.8-flash

# How many days back to check for "new" release notes (7 = weekly)
LOOKBACK_DAYS=7

# Local port for the web dashboard (http://localhost:5000)
DASHBOARD_PORT=5000

# Weekly email delivery (optional — uses Gmail SMTP with a 16-char Google App Password)
# Replace with your own email address(es). You can comma-separate multiple recipients in EMAIL_TO.
EMAIL_TO=you@example.com
SMTP_USER=your.gmail@gmail.com
SMTP_APP_PASSWORD=
# Optional: override these if using a non-Gmail SMTP provider
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

